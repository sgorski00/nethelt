<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pl.sgorski.nethelt</groupId>
    <artifactId>nethelt-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>desktop-client</artifactId>
  <packaging>pom</packaging>
  <name>Nethelt Desktop Client - BOM</name>
  <description>${project.name}</description>

  <properties>
    <version.assembly.plugin>3.7.1</version.assembly.plugin>
    <version.dependency.plugin>3.8.1</version.dependency.plugin>
    <version.antrun.plugin>3.1.0</version.antrun.plugin>
    <version.exec.plugin>3.5.0</version.exec.plugin>
  </properties>

  <modules>
    <module>client-core</module>
    <module>bg-client</module>
    <module>gui-client</module>
    <module>cli-client</module>
  </modules>

  <profiles>
    <profile>
      <id>dist</id>
      <modules>
        <module>distribution</module>
      </modules>
    </profile>
  </profiles>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${version.maven.compiler}</version>
          <configuration>
            <release>${java.version}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <executions>
            <execution>
              <id>repackage</id>
              <goals>
                <goal>repackage</goal>
              </goals>
              <configuration>
                <classifier>exec</classifier>
                <mainClass>${project.main.class}</mainClass>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
