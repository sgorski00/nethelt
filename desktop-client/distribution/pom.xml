<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pl.sgorski.nethelt</groupId>
    <artifactId>desktop-client</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>distribution</artifactId>
  <packaging>pom</packaging>
  <name>Nethelt Desktop Client - Distribution</name>
  <description>
    Platform specific app image (shared jlink runtime + native launchers) and its archives.
    Built only with the "dist" profile: mvn package -Pdist -pl desktop-client/distribution -am
  </description>

  <properties>
    <app.name>nethelt</app.name>
    <app.vendor>Sebastian Górski</app.vendor>
    <app.input.dir>${project.build.directory}/jpackage-input</app.input.dir>
    <app.image.dir>${project.build.directory}/app-image</app.image.dir>
    <!-- Union of the JDK modules used by all launchers, regenerate after adding dependencies (see desktop-client/README.md) -->
    <jlink.modules>java.base,java.compiler,java.desktop,java.instrument,java.logging,java.management,java.naming,java.net.http,java.prefs,java.scripting,java.sql,java.xml,jdk.jfr,jdk.unsupported</jlink.modules>
    <!-- Set by the OS/arch profiles below -->
    <dist.os>linux</dist.os>
    <dist.arch>x64</dist.arch>
    <dist.archive.format>tar.gz</dist.archive.format>
    <!-- Launcher icon, jpackage needs .png on Linux, .ico on Windows and .icns on macOS -->
    <dist.icon>${project.basedir}/src/icons/nethelt.png</dist.icon>
    <!-- Windows installer (dist-windows profile) -->
    <winsw.version>2.12.0</winsw.version>
    <winsw.url>https://github.com/winsw/winsw/releases/download/v${winsw.version}/WinSW-x64.exe</winsw.url>
    <!-- WinSW does not publish checksums, update together with winsw.version: sha256sum WinSW-x64.exe -->
    <winsw.sha256>05b82d46ad331cc16bdc00de5c6332c1ef818df8ceefcd49c726553209b3a0da</winsw.sha256>
    <winsw.file>${project.build.directory}/winsw/WinSW-x64.exe</winsw.file>
    <iscc.executable>C:\Program Files (x86)\Inno Setup 6\ISCC.exe</iscc.executable>
    <skipInstaller>false</skipInstaller>
  </properties>

  <dependencies>
    <dependency>
      <groupId>pl.sgorski.nethelt</groupId>
      <artifactId>cli-client</artifactId>
      <version>${project.version}</version>
      <classifier>exec</classifier>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>pl.sgorski.nethelt</groupId>
      <artifactId>bg-client</artifactId>
      <version>${project.version}</version>
      <classifier>exec</classifier>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>${version.dependency.plugin}</version>
        <executions>
          <execution>
            <id>copy-launcher-jars</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <outputDirectory>${app.input.dir}</outputDirectory>
              <artifactItems>
                <artifactItem>
                  <groupId>pl.sgorski.nethelt</groupId>
                  <artifactId>cli-client</artifactId>
                  <version>${project.version}</version>
                  <classifier>exec</classifier>
                  <destFileName>nethelt.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>pl.sgorski.nethelt</groupId>
                  <artifactId>bg-client</artifactId>
                  <version>${project.version}</version>
                  <classifier>exec</classifier>
                  <destFileName>nethelt-agent.jar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.panteleyev</groupId>
        <artifactId>jpackage-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>app-image</id>
            <phase>package</phase>
            <goals>
              <goal>jpackage</goal>
            </goals>
            <configuration>
              <type>APP_IMAGE</type>
              <name>${app.name}</name>
              <appVersion>${app.version}</appVersion>
              <vendor>${app.vendor}</vendor>
              <description>NetHelt network monitoring client</description>
              <icon>${dist.icon}</icon>
              <input>${app.input.dir}</input>
              <mainJar>nethelt.jar</mainJar>
              <launchers>
                <launcher>
                  <name>nethelt-agent</name>
                  <file>${project.basedir}/src/jpackage/nethelt-agent.properties</file>
                </launcher>
              </launchers>
              <addModules>${jlink.modules}</addModules>
              <jLinkOptions>
                <jLinkOption>--strip-debug</jLinkOption>
                <jLinkOption>--no-header-files</jLinkOption>
                <jLinkOption>--no-man-pages</jLinkOption>
                <jLinkOption>--strip-native-commands</jLinkOption>
              </jLinkOptions>
              <destination>${app.image.dir}</destination>
              <removeDestination>true</removeDestination>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>${version.assembly.plugin}</version>
        <executions>
          <execution>
            <id>core-archive</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>src/assembly/core.xml</descriptor>
              </descriptors>
              <finalName>${app.name}-core-${dist.os}-${dist.arch}</finalName>
              <appendAssemblyId>false</appendAssemblyId>
              <attach>false</attach>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>dist-windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <dist.os>windows</dist.os>
        <dist.archive.format>zip</dist.archive.format>
        <dist.icon>${project.basedir}/src/icons/nethelt.ico</dist.icon>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <configuration>
              <winConsole>true</winConsole>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>${version.antrun.plugin}</version>
            <executions>
              <execution>
                <id>download-winsw</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <skip>${skipInstaller}</skip>
                  <target>
                    <mkdir dir="${project.build.directory}/winsw"/>
                    <get src="${winsw.url}" dest="${winsw.file}" skipexisting="true"/>
                    <checksum file="${winsw.file}" algorithm="SHA-256" property="${winsw.sha256}" verifyproperty="winsw.checksum.ok"/>
                    <fail message="Checksum mismatch for ${winsw.file}, expected ${winsw.sha256}">
                      <condition>
                        <isfalse value="${winsw.checksum.ok}"/>
                      </condition>
                    </fail>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!-- Runs after jpackage, see src/windows/nethelt.iss -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${version.exec.plugin}</version>
            <executions>
              <execution>
                <id>windows-installer</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <skip>${skipInstaller}</skip>
                  <executable>${iscc.executable}</executable>
                  <arguments>
                    <argument>/Q</argument>
                    <argument>/DAppVersion=${app.version}</argument>
                    <argument>/DAppImageDir=${app.image.dir}\${app.name}</argument>
                    <argument>/DWinSWExe=${winsw.file}</argument>
                    <argument>/DOutputDir=${project.build.directory}</argument>
                    <argument>${project.basedir}\src\windows\nethelt.iss</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>dist-macos</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <dist.os>macos</dist.os>
        <dist.icon>${project.basedir}/src/icons/nethelt.icns</dist.icon>
      </properties>
    </profile>
    <profile>
      <id>dist-arm64</id>
      <activation>
        <os>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <dist.arch>arm64</dist.arch>
      </properties>
    </profile>
  </profiles>
</project>
