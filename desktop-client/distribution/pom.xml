<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>pl.sgorski.nethelt</groupId>
    <artifactId>desktop-client</artifactId>
    <version>1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>distribution</artifactId>
  <packaging>pom</packaging>
  <name>Nethelt Desktop Client - Distribution</name>
  <description>
    Platform specific app image (shared jlink runtime + native launchers) and its archives.
    Built only with the "dist" profile: mvn package -Pdist -pl desktop-client/distribution -am
  </description>

  <properties>
    <app.name>nethelt</app.name>
    <app.version>1.0.0</app.version>
    <app.vendor>Sebastian Górski</app.vendor>
    <app.input.dir>${project.build.directory}/jpackage-input</app.input.dir>
    <app.image.dir>${project.build.directory}/app-image</app.image.dir>
    <!-- Union of the JDK modules used by all launchers, regenerate after adding dependencies (see desktop-client/README.md) -->
    <jlink.modules>java.base,java.compiler,java.desktop,java.instrument,java.logging,java.management,java.naming,java.net.http,java.prefs,java.scripting,java.sql,java.xml,jdk.jfr,jdk.unsupported</jlink.modules>
    <!-- Set by the OS/arch profiles below -->
    <dist.os>linux</dist.os>
    <dist.arch>x64</dist.arch>
    <dist.archive.format>tar.gz</dist.archive.format>
  </properties>

  <dependencies>
    <dependency>
      <groupId>pl.sgorski.nethelt</groupId>
      <artifactId>cli-client</artifactId>
      <version>${project.version}</version>
      <classifier>exec</classifier>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>pl.sgorski.nethelt</groupId>
      <artifactId>bg-client</artifactId>
      <version>${project.version}</version>
      <classifier>exec</classifier>
      <exclusions>
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>${version.dependency.plugin}</version>
        <executions>
          <execution>
            <id>copy-launcher-jars</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <outputDirectory>${app.input.dir}</outputDirectory>
              <artifactItems>
                <artifactItem>
                  <groupId>pl.sgorski.nethelt</groupId>
                  <artifactId>cli-client</artifactId>
                  <version>${project.version}</version>
                  <classifier>exec</classifier>
                  <destFileName>nethelt.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>pl.sgorski.nethelt</groupId>
                  <artifactId>bg-client</artifactId>
                  <version>${project.version}</version>
                  <classifier>exec</classifier>
                  <destFileName>nethelt-agent.jar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.panteleyev</groupId>
        <artifactId>jpackage-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>app-image</id>
            <phase>package</phase>
            <goals>
              <goal>jpackage</goal>
            </goals>
            <configuration>
              <type>APP_IMAGE</type>
              <name>${app.name}</name>
              <appVersion>${app.version}</appVersion>
              <vendor>${app.vendor}</vendor>
              <description>NetHelt network monitoring client</description>
              <input>${app.input.dir}</input>
              <mainJar>nethelt.jar</mainJar>
              <launchers>
                <launcher>
                  <name>nethelt-agent</name>
                  <file>${project.basedir}/src/jpackage/nethelt-agent.properties</file>
                </launcher>
              </launchers>
              <addModules>${jlink.modules}</addModules>
              <jLinkOptions>
                <jLinkOption>--strip-debug</jLinkOption>
                <jLinkOption>--no-header-files</jLinkOption>
                <jLinkOption>--no-man-pages</jLinkOption>
                <jLinkOption>--strip-native-commands</jLinkOption>
              </jLinkOptions>
              <destination>${app.image.dir}</destination>
              <removeDestination>true</removeDestination>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>${version.assembly.plugin}</version>
        <executions>
          <execution>
            <id>core-archive</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <descriptors>
                <descriptor>src/assembly/core.xml</descriptor>
              </descriptors>
              <finalName>${app.name}-core-${dist.os}-${dist.arch}</finalName>
              <appendAssemblyId>false</appendAssemblyId>
              <attach>false</attach>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>dist-windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <dist.os>windows</dist.os>
        <dist.archive.format>zip</dist.archive.format>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <configuration>
              <winConsole>true</winConsole>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>dist-macos</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <dist.os>macos</dist.os>
      </properties>
    </profile>
    <profile>
      <id>dist-arm64</id>
      <activation>
        <os>
          <arch>aarch64</arch>
        </os>
      </activation>
      <properties>
        <dist.arch>arm64</dist.arch>
      </properties>
    </profile>
  </profiles>
</project>
